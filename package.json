{
  "name": "xian",
  "version": "0.1.0",
  "description": "码界修仙记 — A terminal RPG for programmers powered by your Git activity",
  "type": "module",
  "bin": {
    "xian": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "clean": "rimraf dist",
    "release": "npm run build && npm publish"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "ink": "^4.4.1",
    "node-machine-id": "^1.1.12",
    "picocolors": "^1.0.0",
    "react": "^18.2.0",
    "simple-git": "^3.21.0",
    "sql.js": "^1.10.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/sql.js": "^1.4.9",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "terminal",
    "rpg",
    "cli",
    "tui",
    "developer",
    "git",
    "productivity",
    "xian"
  ],
  "license": "MIT"
}
